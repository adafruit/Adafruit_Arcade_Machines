# Third-party Arduino libraries -- installed via arduino-cli, not our code.
# This library has exactly ONE dependency (see library.properties); reinstall
# with:
#   arduino-cli lib install "PicoDVI - Adafruit Fork"
# (its own dependencies -- Adafruit GFX Library, Adafruit BusIO, Adafruit
# CPFS -- are pulled in automatically. Nothing here uses SdFat or the TLV320
# library: audio talks to the DAC over raw hardware/i2c.h and storage is a
# raw SPI driver plus vendored FatFs under src/boards/fruitjam/.)
#
# NOTE: no trailing slashes. A trailing slash matches directories ONLY, so
# these patterns silently stopped ignoring these paths the moment they became
# symlinks rather than real directories -- which is how 13 broken, absolute,
# self-referential symlinks (libraries/Adafruit_BusIO -> /Volumes/.../
# libraries/Adafruit_BusIO) got committed and published. Anyone cloning got 13
# dangling links. Leave these unslashed so both forms stay ignored.
libraries/Adafruit_*
libraries/PicoDVI_-_Adafruit_Fork
libraries/SdFat_-_Adafruit_Fork
libraries/Bounce2
libraries/MIDI_Library
libraries/FlashStorage

# Build output / caches
build/
*.uf2
*.elf
*.bin
*.hex

# macOS
.DS_Store

# Host test harness build output (extras/tools/*_host/) -- native binaries and
# macOS debug bundles. `build/` above already covers their object dirs.
extras/tools/*_host/*_host
extras/tools/*_host/*.dSYM/

# Screen-geometry conformance runner (extras/tools/geom_test/) -- its binary and
# macOS debug bundle. Same shape as the m6502 runner below.
extras/tools/geom_test/geom_test
extras/tools/geom_test/*.dSYM/

# CPU conformance runner (extras/tools/m6502_test/) -- its binary, and the
# third-party 6502 test programs it runs, which are fetched rather than
# vendored (see that tool's main.cpp header).
extras/tools/m6502_test/m6502_test
extras/tools/m6502_test/*.dSYM/
extras/tools/m6502_test/programs/

# Game Boy core conformance runner (extras/tools/gb_test/) -- its binary and
# macOS debug bundle, the third-party test ROMs it fetches (see
# fetch_roms.sh), and its frame/audio dumps.
extras/tools/gb_test/gb_test
extras/tools/gb_test/*.dSYM/
extras/tools/gb_test/roms/
extras/tools/gb_test/out/

# Game Boy machine host harness (extras/tools/gb_host/) -- its binary and
# macOS debug bundle, the per-cartridge /cart folders it is run against
# (they hold commercial ROMs such as Tetris), and its frame/audio dumps.
extras/tools/gb_host/gb_host
extras/tools/gb_host/*.dSYM/
extras/tools/gb_host/carts/
extras/tools/gb_host/out/

# USB gamepad decoder test (extras/tools/usb_gamepad_test/) -- its binary
# and macOS debug bundle. Its captures/ ARE tracked: they are the test data.
extras/tools/usb_gamepad_test/usb_gamepad_test
extras/tools/usb_gamepad_test/*.dSYM/

# Claude Code worktrees -- transient checkouts with their own build output.
# Narrow on purpose: a future tracked .claude/settings.json stays visible.
.claude/worktrees/

# Built firmware for testing / GitHub release assets. The binaries are
# build output and belong on a release, not in the tree; the directory's
# own README and build script are tracked.
extras/dist/*
!extras/dist/README.md
!extras/dist/build_all.sh
